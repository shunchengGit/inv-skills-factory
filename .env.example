# ── GitHub 仓库 ──
# INV_KNOWLEDGE_REPO_URL=           # 知识库远程仓库（默认 git@github.com:shunchengGit/inv-knowledge.git）
# INV_REPORT_REPO_URL=              # 研报库远程仓库（默认 git@github.com:shunchengGit/inv-report.git）

# ── 本地路径 ──
# INV_KNOWLEDGE_ROOT=               # 知识库本地根目录（默认 ~/.inv-knowledge）
# RESEARCH_PDF_ROOT=                # 研报库本地根目录（默认 ~/.inv-report）

# ── 部署目标 ──────────────────────────────────────────────────────────
# DEPLOY_SKILLS_DIR=               # 部署子目录名（默认 inv-skills）