# ── 部署 ──
SYNC_PROFILE=home

# ── 邮箱（必填）──
TL_MAIL_USER=your@email.com
TL_MAIL_PASS=your-imap-auth-code

# ── 个人周报邮件（必填）──
# 发件人邮箱使用 TL_MAIL_USER，展示名由此变量控制
WEEKLY_REPORT_FROM_NAME=YourName
WEEKLY_REPORT_TO=recipient@email.com
WEEKLY_REPORT_CC=cc1@email.com,cc2@email.com

# ── 图片识别（讯飞星火）──
XOPKIMIK26_API_KEY=your-xunfei-api-key

# ── GitHub 仓库 ──
KNOWLEDGE_REPO_URL=git@github.com:your/knowledge.git
TODO_REPO_URL=git@github.com:your/todo.git
STOCK_REPORT_REPO_URL=git@github.com:your/stock-report.git

# ── SkillOpt 模型配置 ────────────────────────────────────────────────
# OpenAI-compatible endpoint (讯飞星火等)
export AZURE_OPENAI_ENDPOINT=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
export AZURE_OPENAI_API_KEY=your-api-key
export AZURE_OPENAI_AUTH_MODE=openai_compatible
export OPTIMIZER_DEPLOYMENT=xopglm51
export TARGET_DEPLOYMENT=xopglm51

# ── SkillOpt 运行参数 ────────────────────────────────────────────────
# 以下参数有合理默认值，通常无需修改
# export SKILLOPT_REASONING_EFFORT=medium
# export SKILLOPT_TARGET_BACKEND=openai_chat
# export SKILLOPT_OPTIMIZER_BACKEND=openai_chat
# export SKILLOPT_WORKERS=4
# export SKILLOPT_MAX_COMPLETION_TOKENS=4096
# export SKILLOPT_BATCH_SIZE=10
# export SKILLOPT_LEARNING_RATE=3
